<Window x:Class="AutoConnectNearestPipeTool.UI.AutoConnectNearestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sprinkler Auto-Connect (90° Elbow &amp; Tee)" Height="245" Width="410"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F4F5" Foreground="#18181B" Topmost="True"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Header Badge -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🤖 SPRINKLER 90° FITTING AUTO-CONNECT" FontWeight="Bold" Foreground="#1D4ED8" FontSize="12"/>
                <TextBlock Text="Tự động nối các Đầu phun được chọn vào Ống chính" Foreground="#3B82F6" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Info Count -->
        <TextBlock Grid.Row="1" x:Name="lblInfo" Text="Đã nạp 0 Đầu phun được chọn &amp; 0 Ống chính" 
                   FontWeight="SemiBold" Foreground="#18181B" Margin="0,4"/>

        <!-- Note -->
        <TextBlock Grid.Row="2" Text="* Ràng buộc phụ kiện: CHỈ SỬ DỤNG CÚT 90° VÀ TÊ 90°. Nối đúng các Đầu phun được chọn." 
                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Click="BtnCancel_Click" Height="34" 
                    Background="#E4E4E7" Foreground="#18181B" BorderThickness="1" BorderBrush="#D4D4D8" Cursor="Hand"/>
            <Button Grid.Column="2" Content="⚡ NỐI ĐẦU PHUN" Click="BtnOK_Click" Height="34" 
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
