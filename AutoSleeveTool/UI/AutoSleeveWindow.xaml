<Window x:Class="AutoSleeveTool.UI.AutoSleeveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Sleeve Placement Tool - Revit Link &amp; Local Model" Width="480" Height="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" SizeToContent="Height"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="AUTO SLEEVE PLACEMENT TOOL" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Tự động đặt Sleeve (DuctType 'sleeve') xuyên Tường, Cột, Dầm, Sàn (Link &amp; Local)" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Unit Selection -->
        <GroupBox Grid.Row="1" Header="Đơn vị tính (Unit System)" FontWeight="SemiBold" Foreground="#334155" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RadioMm" Content="Millimeter (mm)" IsChecked="True" GroupName="Units" Margin="0,0,25,0" Checked="OnUnitChanged"/>
                <RadioButton x:Name="RadioInch" Content="Inch (in)" GroupName="Units" Checked="OnUnitChanged"/>
            </StackPanel>
        </GroupBox>

        <!-- MEP Targets Selection -->
        <GroupBox Grid.Row="2" Header="Đối tượng MEP (Current Document)" FontWeight="SemiBold" Foreground="#334155" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkDucts" Content="Ducts (Ống gió)" IsChecked="True" Margin="0,0,30,0"/>
                <CheckBox x:Name="ChkPipes" Content="Pipes (Ống nước)" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <!-- Linked & Local Targets Selection -->
        <GroupBox Grid.Row="3" Header="Đối tượng xuyên qua (Local Model &amp; Revit Link)" FontWeight="SemiBold" Foreground="#334155" Padding="10" Margin="0,0,0,10">
            <UniformGrid Columns="2" Rows="2">
                <CheckBox x:Name="ChkWalls" Content="Walls (Tường)" IsChecked="True" Margin="0,4,0,4"/>
                <CheckBox x:Name="ChkColumns" Content="Columns (Cột)" IsChecked="True" Margin="0,4,0,4"/>
                <CheckBox x:Name="ChkBeams" Content="Beams (Dầm kết cấu)" IsChecked="True" Margin="0,4,0,4"/>
                <CheckBox x:Name="ChkFloors" Content="Floors (Sàn)" IsChecked="True" Margin="0,4,0,4"/>
            </UniformGrid>
        </GroupBox>

        <!-- Clearances -->
        <GroupBox Grid.Row="4" Header="Khoảng hở Sleeve (Clearance Offset)" FontWeight="SemiBold" Foreground="#334155" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock x:Name="LblRoundClearance" Text="Clearance ống Tròn (mm):" FontSize="11.5" FontWeight="Normal" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtRoundClearance" Text="25" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#0F172A" BorderThickness="1" BorderBrush="#94A3B8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="LblRectClearance" Text="Clearance ống Vuông (mm):" FontSize="11.5" FontWeight="Normal" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtRectClearance" Text="50" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#0F172A" BorderThickness="1" BorderBrush="#94A3B8"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Action Button -->
        <Button Grid.Row="5" x:Name="BtnRun" Content="BẮT ĐẦU ĐẶT SLEEVE TỰ ĐỘNG" Click="BtnRun_Click"
                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="13" Height="42" Padding="12,0"
                Cursor="Hand" BorderThickness="0" Margin="0,4,0,4">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
