<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AlignMEPToCeiling</AssemblyName>
    <RootNamespace>AlignMEPToCeiling</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="icon32.png">
      <LogicalName>AlignMEPToCeiling.icon32.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon.png">
      <LogicalName>AlignMEPToCeiling.icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

