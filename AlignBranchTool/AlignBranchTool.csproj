<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AlignBranchTool</AssemblyName>
    <RootNamespace>RevitAlignTools</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon32.png">
      <LogicalName>AlignBranchTool.icon32.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon.png">
      <LogicalName>AlignBranchTool.icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
