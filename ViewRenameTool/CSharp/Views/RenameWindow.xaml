<Window x:Class="ViewRenameTool.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Đổi Tên View (View Rename) - Antigravity AI" 
        Height="560" Width="760" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3,6,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ĐỔI TÊN HÀNG LOẠT CÁC VIEW DỰ ÁN REVIT" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Cấu hình Tên gốc chung + Tùy chọn Tiền tố Level (vd: 1ST VERTICAL PENETRATION SLEEVE) &amp; Hậu tố" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Parameters Input Group -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Base Name -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Tên gốc chung (Base Name):" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding BaseName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tên gốc áp dụng cho tất cả view được chọn"/>
                </StackPanel>

                <!-- Prefix Options -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Tiền tố (Prefix):" FontWeight="Bold" Margin="0,0,0,4"/>
                    <CheckBox IsChecked="{Binding UseLevelPrefix, UpdateSourceTrigger=PropertyChanged}" Content="Tự động lấy Tên Level làm Tiền tố (vd: 1ST, 2ND)" Margin="0,0,0,6"/>
                    <TextBlock Text="Tiền tố bổ sung (nếu có):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding CustomPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Suffix & Options -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Hậu tố &amp; Ký tự phân cách:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hậu tố (Suffix):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phân cách:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox IsChecked="{Binding AutoIndex, UpdateSourceTrigger=PropertyChanged}" Content="Tự động đánh số (-01, -02) nếu trùng tên trong cùng tầng"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Live Preview DataGrid -->
        <GroupBox Grid.Row="2" Header="Bảng Xem Trước Tên Mới Dự Kiến (Live Preview)" FontWeight="Bold" Foreground="#0F172A">
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" 
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="White" RowHeaderWidth="0" Margin="0,8,0,0"
                      FontSize="12" FontFamily="Segoe UI">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Đổi tên" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                    <DataGridTextColumn Header="Tên View Hiện Tại" Binding="{Binding OriginalName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Level / Tầng" Binding="{Binding LevelName}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tên Mới Dự Kiến (IN HOA)" Binding="{Binding CalculatedName}" Width="2.2*" Foreground="#2563EB" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Đổi Tên View (Apply)" Click="BtnApply_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/>
            <Button Content="Hủy Bỏ (Cancel)" Click="BtnCancel_Click" Background="#E2E8F0" Foreground="#334155" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
