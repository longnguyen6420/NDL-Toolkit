<Window x:Class="PipePlaceholderTool.UI.PipePlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PipePlaceholder Settings" Height="460" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F4F5" Foreground="#18181B" Topmost="True"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- System Type -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="System Type" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboSystemType" Margin="0,3" Padding="6,4"/>

        <!-- Topology -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Topology" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboTopology" Margin="0,3" Padding="6,4">
            <ComboBoxItem Content="Tree / Dead-end" IsSelected="True"/>
            <ComboBoxItem Content="Loop / Network"/>
            <ComboBoxItem Content="Single Line"/>
        </ComboBox>

        <!-- Level -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Level" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboLevel" Margin="0,3" Padding="6,4"/>

        <!-- Layer Name -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Layer Name" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboLayerName" IsEditable="True" Margin="0,3" Padding="6,4"/>

        <!-- Elevation -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Elevation" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtElevation" Text="9 6" Margin="0,3" Padding="6,4" Width="140" HorizontalAlignment="Left"/>

        <!-- Main Pipe Type -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Main Pipe Type" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cboMainPipeType" Margin="0,3" Padding="6,4"/>

        <!-- Main Size -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Main Size" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtMainSize" Text="100" Margin="0,3" Padding="6,4" Width="140" HorizontalAlignment="Left"/>

        <!-- Branch Pipe Type -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="Branch Pipe Type" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cboBranchPipeType" Margin="0,3" Padding="6,4"/>

        <!-- Branch Size -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Branch Size" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtBranchSize" Text="50" Margin="0,3" Padding="6,4" Width="140" HorizontalAlignment="Left"/>

        <!-- Action Buttons (Cancel & OK) -->
        <Grid Grid.Row="9" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Click="BtnCancel_Click" Height="32" 
                    Background="#E4E4E7" Foreground="#18181B" BorderThickness="1" BorderBrush="#D4D4D8" Cursor="Hand"/>
            <Button Grid.Column="2" Content="OK" Click="BtnOK_Click" Height="32" 
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Use AI Vision Checkbox -->
        <CheckBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="chkUseAIVision" Content="Use AI Vision" 
                  Margin="0,8,0,0" VerticalAlignment="Center" Foreground="#52525B"/>
    </Grid>
</Window>
