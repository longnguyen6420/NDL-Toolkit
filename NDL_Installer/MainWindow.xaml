<Window x:Class="NDL_Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NDL Revit Tools Suite Installer" Height="540" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC" Topmost="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="🚀 BỘ CÔNG CỤ NDL REVIT ADD-IN" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
            <TextBlock Text="Cài đặt 1-Click tự động tích hợp Ribbon NDL cho Revit" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tool List Banner -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📌 Danh sách các Tool có trong Installer này:" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtToolList" Text="Đang quét bộ công cụ NDL..." TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Log Output -->
        <GroupBox Grid.Row="2" Header="Trạng thái cài đặt (Installation Log)" Foreground="#94A3B8" Margin="0,0,0,12">
            <TextBox x:Name="txtLog" IsReadOnly="True" Background="#020617" Foreground="#4ADE80" 
                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Version Status -->
        <TextBlock Grid.Row="3" x:Name="txtRevitVersions" Text="Phát hiện: Quét các phiên bản Revit..." Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,12" HorizontalAlignment="Center"/>

        <!-- Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="⚡ CÀI ĐẶT BỘ TOOL NDL" Click="BtnInstall_Click" Background="#059669" Height="42"/>
            <Button Grid.Column="1" Content="❌ GỠ BỎ" Click="BtnUninstall_Click" Background="#DC2626" Height="42"/>
        </Grid>
    </Grid>
</Window>
